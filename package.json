{
  "name": "pi-durable-bot",
  "version": "0.3.1",
  "description": "Open-source AI coworkers that read every channel, decide what matters, and act on their own computer. Self-hosted, any model.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Crokily/pi-durable-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crokily/pi-durable-bot.git"
  },
  "bugs": {
    "url": "https://github.com/Crokily/pi-durable-bot/issues"
  },
  "keywords": [
    "ai-agent",
    "ai-coworker",
    "slack-bot",
    "self-hosted",
    "pi-durable",
    "chat-sdk"
  ],
  "bin": {
    "pots": "dist/cli/pots.js"
  },
  "files": [
    "dist",
    "docs/channels",
    "docs/for-agents.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli/pots.ts start",
    "pots": "node src/cli/pots.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "tla": "node scripts/tlc.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@chat-adapter/slack": "4.43.0",
    "@chat-adapter/state-memory": "4.43.0",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "@effect/platform-node": "4.0.7",
    "@effect/platform-node-shared": "4.0.7",
    "chat": "4.43.0",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.7",
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
