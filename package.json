{
  "name": "pi-durable-bot",
  "version": "0.7.0",
  "description": "Open-source AI coworkers that read every channel, decide what matters, and act on their own computer. Self-hosted, any model.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Crokily/pi-durable-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crokily/pi-durable-bot.git"
  },
  "bugs": {
    "url": "https://github.com/Crokily/pi-durable-bot/issues"
  },
  "keywords": [
    "ai-agent",
    "ai-coworker",
    "slack-bot",
    "self-hosted",
    "pi-durable",
    "chat-sdk",
    "grok-bot-alternative",
    "pi-package"
  ],
  "bin": {
    "pots": "dist/cli/pots.js"
  },
  "files": [
    "dist",
    "skills",
    "kit",
    "pi-package",
    "docs/for-agents.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "skills": [
      "./pi-package/skills"
    ],
    "video": "https://github.com/Crokily/pi-durable-bot/raw/refs/heads/main/docs/media/demo.mp4"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli/pots.ts start",
    "pots": "node src/cli/pots.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "tla": "node scripts/tlc.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@chat-adapter/discord": "4.44.0",
    "@chat-adapter/slack": "4.44.0",
    "@chat-adapter/state-memory": "4.44.0",
    "@chat-adapter/telegram": "4.44.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@earendil-works/pi-telemetry": "1.5.0",
    "@effect/platform-node": "4.1.2",
    "@effect/platform-node-shared": "4.1.2",
    "chat": "4.44.0",
    "discord.js": "14.28.1",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  },
  "overrides": {
    "@earendil-works/chord": {
      "ws": "$ws"
    }
  }
}
