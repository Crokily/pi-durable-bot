# Template. scripts/deploy.sh fills in the @...@ values and installs it as /etc/systemd/system/personal-bot.service.
[Unit]
Description=personal-bot gateway (Slack bots)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP@
ExecStart=@NODE@ src/main.ts
Environment=PATH=@NODE_BIN@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
